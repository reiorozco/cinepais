GOOGLE_API_KEY=
WEB_API_BASE_URL=http://localhost:3000
# Comma-separated list of allowed origins (whitespace around each entry is trimmed).
# Add the Vercel preview domain alongside production — previews live on their own hostnames.
CORS_ORIGIN=http://localhost:3000,https://cinepais.vercel.app
MAX_OUTPUT_TOKENS=1024
MAX_INPUT_CHARS=2000
SESSION_QUERY_CAP=20
# Global budget of accepted /chat requests per UTC day. 40 x ~3.5 Gemini calls per request
# = ~140 generation calls, sized against the ~USD 2.50 LLM credit.
# Courtesy brake, NOT a hard ceiling: the counter is in-process and resets on every cold start.
DAILY_REQUEST_CAP=40
# Documented default, pinned to the validated model. gemini-3.6-flash is the current head of
# the chain, proven end-to-end (emits the recommendation event with the soldout tradeoff);
# gemini-3.5-flash is the fallback. Lite variants broke tool-calling (never called
# recommend_best). Clear this to fall back to runtime model discovery.
AGENT_MODEL_OVERRIDE=gemini-3.6-flash
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cinepais-agent
